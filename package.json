{
    "name": "tracflux",
    "private": true,
    "version": "1.4.1",
    "description": "Outil de conception et d'optimisation de diagrammes de feux tricolores",
    "license": "AGPL-3.0-or-later",
    "author": "Thierry Colmon",
    "repository": {
        "type": "git",
        "url": "https://github.com/ThierryClm/TraCflux.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "types": "tsc --noEmit",
        "build": "vite build",
        "preview": "vite preview",
        "preview:deploy": "node scripts/deploy-preview.mjs",
        "serve": "node scripts/serve-local.mjs",
        "clean": "rmdir /S /Q dist 2>nul & taskkill /F /IM node.exe /T 2>nul",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "check": "node scripts/check-deps.mjs",
        "release": "node scripts/release.mjs"
    },
    "dependencies": {
        "fflate": "^0.8.2",
        "html2canvas": "^1.4.1",
        "jspdf": "^4.2.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@babel/core": "^7.28.5",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/ui": "^4.1.7",
        "jsdom": "^29.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.13",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.7"
    }
}
