{
    // Tout le code de l'application est en TypeScript (`.ts` / `.tsx`),
    // vérifié en mode strict.
    //
    // Restent en JavaScript une partie des tests et leur configuration :
    // `allowJs` les laisse importer les modules typés. `checkJs` est à false :
    // un fichier JavaScript n'est contrôlé que s'il porte `// @ts-check`.
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",

        "allowJs": true,
        "checkJs": false,
        "noEmit": true,

        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,

        // Une exception assumée à `strict`. TypeScript type la variable d'un
        // bloc `catch` en `unknown`, ce qui est plus sûr dans l'absolu mais
        // obligerait à convertir une trentaine de `catch (e) { ... e.message }`
        // sans rien apprendre sur ce dépôt : on n'y rattrape que des erreurs
        // du navigateur et des exceptions de JSON.parse.
        "useUnknownInCatchVariables": false,

        // Les types des dépendances ne sont pas notre affaire : les vérifier
        // n'apprend rien sur ce dépôt et noie le vrai signal.
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src", "vite.config.ts"],
    "exclude": ["node_modules", "dist"]
}
